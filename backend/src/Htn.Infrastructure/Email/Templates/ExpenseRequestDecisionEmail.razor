<EmailLayout Title="@($"Your expense request was {Decision.ToLowerInvariant()}")" Preheader="@($"{Title} · {Amount}")" BrandColor="@BrandColor" LogoCid="@LogoCid" Heading="Expense request">
  <p style="margin-top:0;">Hi @FirstName,</p>
  <p>Your expense request <strong>@Title</strong> for <strong>@Amount</strong> was <strong>@Decision.ToLowerInvariant()</strong> by @DecidedBy.</p>
  @if (!string.IsNullOrWhiteSpace(Note))
  {
    <blockquote style="margin:16px 0;padding:12px 16px;border-left:3px solid @BrandColor;background:#f9fafb;color:#374151;white-space:pre-wrap;">@Note</blockquote>
  }
  @if (Approved)
  {
    <p>The CFO will mark it paid once the money goes out.</p>
  }
  <EmailButton Href="@Link" Label="Open expense requests" BrandColor="@BrandColor" />
</EmailLayout>

@code {
    [Parameter, EditorRequired] public string FirstName { get; set; } = "";
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>Already formatted in pesos, so the template never does money arithmetic.</summary>
    [Parameter, EditorRequired] public string Amount { get; set; } = "";

    /// <summary>"Approved" or "Rejected".</summary>
    [Parameter, EditorRequired] public string Decision { get; set; } = "";

    [Parameter, EditorRequired] public string DecidedBy { get; set; } = "";
    [Parameter] public bool Approved { get; set; }

    /// <summary>The CFO's note on an approval, or the required reason on a rejection. Razor escapes it.</summary>
    [Parameter] public string? Note { get; set; }

    [Parameter, EditorRequired] public string Link { get; set; } = "";
    [Parameter] public string BrandColor { get; set; } = Brand.Color;
    [Parameter] public string? LogoCid { get; set; }
}
