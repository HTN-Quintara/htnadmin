# Local secrets and config for docker compose. Copy to .env and fill in:
#   cp .env.example .env
# .env is git-ignored (see .gitignore); this file is committed and must never hold real secrets.

# --- Database (required) ---
# Any non-empty value. Used for the Postgres superuser and in the API connection string below.
POSTGRES_PASSWORD=change-me
# Must match POSTGRES_PASSWORD. Host is the compose service name, not localhost.
ConnectionStrings__Db=Host=db;Database=htn;Username=htn;Password=change-me

# --- Email (optional in Development) ---
# Without a token the API logs outgoing email instead of sending it. Outside Development the API
# refuses to start unless MAILTRAP_API_TOKEN is set (or Email__AllowLoggingSender=true).
MAILTRAP_API_TOKEN=
MAILTRAP_MODE=sandbox
MAILTRAP_INBOX_ID=
MAIL_FROM=HackTheNorth.PH <no-reply@hackthenorth.ph>

# --- QR tickets (optional until the registrations slice lands) ---
# 32+ random bytes, base64: openssl rand -base64 32
QR_SIGNING_KEY=

# --- App ---
ASPNETCORE_ENVIRONMENT=Development
App__PublicBaseUrl=http://localhost:5173
# Seeds the sample accounts (alex@hackthenorth.ph / Dev-Password-123!). Development only.
SEED_DEV=true
